  "info": {
    "title": "FrogRadar",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/brief": {
      "get": {
        "operationId": "get_brief_api_brief_get",
        "parameters": [
          {
            "in": "query",
            "name": "days",
            "required": false,
            "schema": {
              "default": 7,
              "maximum": 90,
              "minimum": 1,
              "title": "Days",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 5,
              "maximum": 20,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BriefOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Brief",
        "tags": [
          "brief"
        ]
      }
    },
    "/api/entities": {
      "get": {
        "operationId": "list_entities_api_entities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/EntityOut"
                  },
                  "title": "Response List Entities Api Entities Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Entities",
        "tags": [
          "entities"
        ]
      }
    },
    "/api/nav": {
