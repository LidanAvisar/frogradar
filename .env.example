# Copy to .env and fill in what you have (`make live`). Never commit .env.
# Every key is optional: a missing key turns its features off or degrades them, and the app says
# which (startup log, `make status`, System status in the UI). No keys at all? Use `make demo`.

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Web search for the research agent
TAVILY_API_KEY=
# MCP server over HTTP at /mcp (S16): clients send Authorization: Bearer <MCP_TOKEN>. Empty = /mcp not started.
MCP_TOKEN=
# Host header values allowed for /mcp (DNS-rebinding protection), comma list.
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*

# Optional model overrides (LiteLLM ids). Leave empty to use config/llm_routing.yaml
# (bulk anthropic/claude-haiku-5-5, synthesis anthropic/claude-sonnet-5-5, verify openai/gpt-5.4-mini,
# embedding openai/text-embedding-3-small).
# Single provider (one key only): route every tier to it, e.g. Anthropic only:
#   LLM_MODEL_BULK=anthropic/claude-haiku-5-5  LLM_MODEL_SYNTHESIS=anthropic/claude-sonnet-5-5
#   LLM_MODEL_VERIFY=anthropic/claude-haiku-5-5  ALLOW_SAME_FAMILY_VERIFY=true
# (Anthropic has no embedding model: without OPENAI_API_KEY, free-form Ask and dedup are off.
#  Another 1536-dim embedding model works too, but stored vectors must then be re-embedded.)
LLM_MODEL_BULK=
LLM_MODEL_SYNTHESIS=
LLM_MODEL_VERIFY=
EMBEDDING_MODEL=
# The verifier must come from a different model family than the writers. true = start anyway with a
# warning ("accuracy checks are weaker"); for single-provider setups only.
ALLOW_SAME_FAMILY_VERIFY=false

# Database
POSTGRES_USER=frogradar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=frogradar
DATABASE_URL=postgresql+psycopg://frogradar:change-me@localhost:5432/frogradar

# App
# Directory with the YAML config files (default: <repo>/config; /app/config in Docker)
# CONFIG_DIR=
# Demo mode (`make demo` sets it): snapshot data, cached answers only, no provider calls.
DEMO_MODE=false
DAILY_RUN_CRON=0 6 * * *
# Hard daily cap on LLM spend (UTC day); shown in the UI with today's spend. A daily run costs ~$0.08.
LLM_DAILY_BUDGET_USD=2
# Pin the app's "today" (ISO time); empty = wall clock. Demo mode pins it to the snapshot's date.
PIN_NOW=
# LLM gateway reliability (defaults shown)
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3

# Collectors. Optional GitHub token (no scopes needed) raises the API limit from 60 to 5000 req/hour.
GITHUB_TOKEN=
# COLLECTOR_TIMEOUT_S=20
# COLLECTOR_DOMAIN_DELAY_S=1
