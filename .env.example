# Copy to .env and fill in. Never commit .env.

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Web search for the research agent
TAVILY_API_KEY=

# Optional model overrides (LiteLLM ids). Leave empty to use config/llm_routing.yaml.
LLM_MODEL_BULK=
LLM_MODEL_SYNTHESIS=
LLM_MODEL_VERIFY=
EMBEDDING_MODEL=

# Database
POSTGRES_USER=frogradar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=frogradar
DATABASE_URL=postgresql+psycopg://frogradar:change-me@localhost:5432/frogradar

# App
# Directory with the YAML config files (default: <repo>/config; /app/config in Docker)
# CONFIG_DIR=
DEMO_MODE=false
DAILY_RUN_CRON=0 6 * * *
LLM_DAILY_BUDGET_USD=2
# LLM gateway reliability (defaults shown)
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
