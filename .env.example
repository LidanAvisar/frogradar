# Copy to .env (cp .env.example .env), add your keys, then `make up`. Never commit .env.
# Keys are only read from the environment: never logged, never returned by the API, never sent to
# the web app. `make status` and System status in the UI show present / missing, never values.

# ---------- Required (the app does not start without them; `make up` names the missing one) ----------
# Anthropic: writes every summary, "Why JFrog cares", the daily brief, battlecards and Ask answers
# (bulk claude-haiku-5-5, synthesis claude-sonnet-5-5).
ANTHROPIC_API_KEY=
# OpenAI: the second model that verifies every claim (gpt-5.4-mini, a different vendor than the
# writer) and the embeddings behind Ask search and dedup (text-embedding-3-small).
OPENAI_API_KEY=

# ---------- Optional (a missing one turns off only its feature; the UI says which) ----------
# Tavily web search for research missions. Without it, missions search FrogRadar's own knowledge
# base only.
TAVILY_API_KEY=
# GitHub token (no scopes needed). Without it, GitHub collectors are limited to 60 requests/hour.
GITHUB_TOKEN=
# MCP server over HTTP at /mcp: clients send Authorization: Bearer <MCP_TOKEN>. Without it, /mcp is
# off (the stdio MCP server, `make mcp`, works without it).
MCP_TOKEN=
# Host header values allowed for /mcp (DNS-rebinding protection), comma list.
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*

# Optional model overrides (LiteLLM ids). Leave empty to use config/llm_routing.yaml
# (bulk anthropic/claude-haiku-5-5, synthesis anthropic/claude-sonnet-5-5, verify openai/gpt-5.4-mini,
# embedding openai/text-embedding-3-small).
# The required keys follow the routing: point a tier at another provider (e.g. gemini/..., with
# GEMINI_API_KEY) and that provider's key becomes the required one. A single provider for every tier
# needs ALLOW_SAME_FAMILY_VERIFY=true (weaker checks). Another embedding model must have 1536
# dimensions, and stored vectors (including the seed's) must then be re-embedded.
LLM_MODEL_BULK=
LLM_MODEL_SYNTHESIS=
LLM_MODEL_VERIFY=
EMBEDDING_MODEL=
# The verifier must come from a different model family than the writers. true = start anyway with a
# warning ("accuracy checks are weaker"); for single-provider setups only.
ALLOW_SAME_FAMILY_VERIFY=false

# Database
POSTGRES_USER=frogradar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=frogradar
DATABASE_URL=postgresql+psycopg://frogradar:change-me@localhost:5432/frogradar

# App
# Directory with the YAML config files (default: <repo>/config; /app/config in Docker)
# CONFIG_DIR=
# Daily pipeline time for `make scheduler-up` (cron, UTC).
DAILY_RUN_CRON=0 6 * * *
# Hard daily cap on LLM spend (UTC day), checked by FrogRadar's LLM gateway before every paid call;
# shown in the UI with today's spend. A daily run costs ~$0.08, the first full run ~$0.25-0.60,
# an Ask question ~$0.02, a research mission ~$0.03-0.05.
LLM_DAILY_BUDGET_USD=2
# LLM gateway reliability (defaults shown)
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3

# Collectors
# COLLECTOR_TIMEOUT_S=20
# COLLECTOR_DOMAIN_DELAY_S=1
